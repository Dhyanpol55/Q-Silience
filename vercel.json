{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "q-resilience-ai",
          "format": "url",
          "env": "Q_RESILIENCE_AI_URL"
        }
      ]
    },
    "q-resilience-ai": {
      "root": "q-resilience-ai",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
